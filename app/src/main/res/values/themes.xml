<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the Warm Ivory token so there is no flash before Compose draws. -->
    <style name="Theme.Journal" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ivory</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
