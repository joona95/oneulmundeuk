<?xml version="1.0" encoding="utf-8"?>
<!-- Personal records are excluded from cloud backup and device transfer until the
     data-protection milestone decides on an encrypted export/backup story. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
