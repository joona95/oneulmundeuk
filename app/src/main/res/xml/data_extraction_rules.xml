<?xml version="1.0" encoding="utf-8"?>
<!-- Personal records (Room) and local preferences incl. the editor draft (DataStore, files/datastore/) are
     excluded from cloud backup and device transfer until the data-protection milestone decides on an
     encrypted export/backup story. On-device AI models (noBackupFilesDir/models, 1 GB+) are never backed up or
     transferred either — re-downloaded instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="root" path="no_backup/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="root" path="no_backup/" />
    </device-transfer>
</data-extraction-rules>
