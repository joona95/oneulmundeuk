<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ system splash: plain Warm Ivory with no icon, so the Compose brand intro (SplashIntro)
      is the only jelly the user sees — no static icon followed by a second, animated one.
    -->
    <style name="Theme.Journal" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ivory</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/ivory</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
